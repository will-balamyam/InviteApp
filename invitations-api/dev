Lifecycle scripts included in invitations-api@0.0.1:
  start
    nest start
  test
    jest

available via `npm run-script`:
  build
    nest build
  format
    prettier --write "src/**/*.ts" "test/**/*.ts"
  start:dev
    nest start --watch
  start:debug
    nest start --debug --watch
  start:prod
    node dist/main
  lint
    eslint "{src,apps,libs,test}/**/*.ts" --fix
  test:watch
    jest --watch
  test:cov
    jest --coverage
  test:debug
    node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand
  test:e2e
    jest --config ./test/jest-e2e.json
  typeorm
    typeorm --dataSource ./data-source.ts
  migration:generate
    ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate ./src/migrations/dbupdated -d ./data-source.ts
  migration:run
    ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./data-source.ts
  migration:revert
    ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./data-source.ts

